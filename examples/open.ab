include "core/unix.ab"
include "core/stack.ab"

mem buffer is 64 u8 end

proc main
    -> i32
is
    open c"examples/open.ab" 0 O_RDONLY ;; (fd)
    peek fd end ;;

    read fd buffer 64 ;; (len fd)
    while > dup .. 0 do
        dup write STDOUT buffer ;; (fd)
        read fd buffer 64       ;; (len fd)
    end ;;
    drop (fd) ;;
    drop close ;;

    0
end
