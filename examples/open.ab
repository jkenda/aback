include "core/linux.ab"
include "core/stack.ab"

mem buffer is char 64 end

proc main
    -> int
is
    open c"examples/open.ab" O_RDONLY ;; (fd)
    peek fd end

    read fd buffer 64 ;; (len fd)
    while > dup 0 do
        dup write STDOUT buffer ;; (fd)
        read fd buffer 64       ;; (len fd)
    end
    drop (fd) ;;
    drop close ;;

    0
end
