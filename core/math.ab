include "stack.ab"

macro min
    a' a' -> a'
is
take a b end
    if <= a b then a
    else b end
end

macro max
    a' a' -> a'
is
take a b end
    if >= a b then a
    else b end
end

proc **
    a' a' -> a'
is
take a b end
    0 1 ;;
    while < dup .. b do
        take i pow in
            + 1 i
            * a pow
        end
    end drop
end
