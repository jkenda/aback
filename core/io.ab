include "core/stack.ab"
include "core/math.ab"


macro STDOUT -> i32 is 1 end
proc write i32 char ptr u64 -> i32 end

(print char)
proc putc
    char ->
is
take c end
    write STDOUT @ c 1 ;;
    drop
end

(print integer)
proc $puti$
    i64 i64 ->
is
take radix n end
    if < n 0 then
        putc '-' ;;
        $puti$ radix - 0 n
    else if < n radix then
        putc to char + to i64 '0' n
    else
        $puti$ radix % n 10 ;;
        putc to char + % n radix to i64 '0'
    end
end

include "core/unix.ab"
macro puts str -> is write STDOUT ;; drop end

macro puti  i64 -> is $puti$ 10 end
macro putib i64 -> is puts "0b" ;; $puti$ 2 end
macro putix i64 -> is puts "0x" ;; $puti$ 16 end


macro $FLOAT_PREC$ -> u64 is 6 end

(print float)
macro putf
    f64 ->
is
    (if negative then print 0 and negate)
    if < dup .. 0. then
        putc '-'
        - 0. ..
    end

    (get the whole and the decimal part)
    to i64 dup .. ;;                 (whole float --)
    - swap to f64 over .. over .. .. ;;   (dec whole float --)
    drop .. -rot .. ;;                (dec whole --)

    (print the whole part)
    swap .. ;; (dec --)
    puti .. ;;
    putc '.'  ;; (dec --)

    (print the decimal part)
    take dec in
        (if the decimal part is non-zero then print it)
        if /= dec 0. then
            (dec *= 10^$float_prec$)
            to i64 * to f64 ** 10 $FLOAT_PREC$ dec ;;
            (remove trailing zeros)
            while = 0 % over .. 10 do
                take dec in
                    / dec 10
                end
            end
            puti
        end
    end
end

(print boolean values
 as "true" or "false")
macro putb
    bool ->
is
take b end
    if b then "true"
    else "false" end
    puts ..
end
